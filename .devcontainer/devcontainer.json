{
  "name": "React Native + Expo",
  "dockerComposeFile": [
    "../compose.yml"
  ],
  "service": "react-react-native-app",
  "workspaceFolder": "/usr/src/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "msjsdiag.vscode-react-native",
        "esbenp.prettier-vscode",
        "openai.chatgpt"
      ]
    }
  },
  "forwardPorts": [
    8081,
    19000,
    19001,
    19002
  ],
  // ホストの SSH エージェントソケットをコンテナ内にマウント
  // これにより、鍵をコピーせずにコンテナ内で Git/SSH が利用可能
  "mounts": [
    "source=${env:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  // SSH クライアントが上記ソケットを参照するように環境変数を設定
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  }
}
